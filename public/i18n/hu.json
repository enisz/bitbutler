          }
        },
        "auto-tmm": {
          "title": "Automatikus Torrentkezelés",
          "description": {
            "line1": "Ha engedélyezve van, a qBittorrent a hozzárendelt kategória alapján kezeli a fájlok helyét.",
            "line2": "Például, ha egy torrent kategóriáját „Filmek”-ről „Sorozatok”-ra módosítod, a szoftver automatikusan átmozgatja a fájlokat a megfelelő mappába."
          }
        },
        "sequential-download": {
          "title": "Sorrendi letöltés",
          "description": {
            "line1": "A torrentek általában véletlenszerű sorrendben töltik le a szeleteket az elérhetőség alapján. Ez az opció kényszeríti a letöltést a fájl elejétől a végéig.",
