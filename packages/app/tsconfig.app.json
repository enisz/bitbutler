{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "./out-tsc/app",
    "types": ["@angular/localize"]
  },
  "include": ["src/**/*.ts"],
  // `test-setup.ts`/`test-providers.ts` are test-only entry points (they belong to
  // `tsconfig.spec.json`, which lists them explicitly) and reference Vitest globals, so they must
  // stay out of the application compilation unit.
  "exclude": [
    "src/**/*.spec.ts",
    "src/**/test-utils/**",
    "src/test-setup.ts",
    "src/test-providers.ts"
  ],
  "angularCompilerOptions": {
    "extendedDiagnostics": {
      "checks": {
        "nullishCoalescingNotNullable": "suppress",
        "optionalChainNotNullable": "suppress"
      }
    }
  }
}
