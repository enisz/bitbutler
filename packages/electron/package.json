{
  "name": "@bitbutler/electron",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "dependencies": {
    "@bitbutler/shared": "*",
    "@jridgewell/trace-mapping": "^0.3.31"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && tsc -p tsconfig.preload.json",
    "watch": "concurrently -n \"main,preload\" \"tsc -p tsconfig.json --watch --preserveWatchOutput\" \"tsc -p tsconfig.preload.json --watch --preserveWatchOutput\"",
    "test": "vitest run"
  }
}
